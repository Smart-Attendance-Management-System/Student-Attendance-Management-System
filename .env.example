# Reference only: Django does not load this file automatically.
# Set values in your shell, deployment platform, or secret manager.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.example.invalid

# Use MySQL in deployments. Set USE_SQLITE=1 for local development and tests.
USE_SQLITE=0
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=your-database-host.example.invalid
DB_PORT=3306

# Secure defaults when DEBUG is off.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
# Enable only when all subdomains use HTTPS and preload is intended.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=0

# SMTP is required when DEBUG is off.
SAMS_SMTP_HOST=
SAMS_SMTP_PORT=587
SAMS_SMTP_USER=
SAMS_SMTP_PASSWORD=
SAMS_SMTP_USE_TLS=1
SAMS_SMTP_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@your-app.example.invalid

SAMS_LOG_LEVEL=INFO
SAMS_LOG_FILE=
